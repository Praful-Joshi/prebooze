{
  "presets": {
    "Long Blend": {
      "bars": 32,
      "sync": true,
      "volume": {
        "curve": "crossfade",
        "strength": 0.5
      },
      "bass": {
        "curve": "swap",
        "strength": 0.75,
        "swap": 0.75
      },
      "mid": {
        "curve": "crossfade",
        "strength": 0.5
      },
      "high": {
        "curve": "crossfade",
        "strength": 0.25
      }
    },
    "Smooth Blend": {
      "bars": 16,
      "sync": true,
      "volume": {
        "curve": "crossfade",
        "strength": 0.5
      },
      "bass": {
        "curve": "swap",
        "strength": 0.75,
        "swap": 0.5
      },
      "mid": {
        "curve": "crossfade",
        "strength": 0.75
      },
      "high": {
        "curve": "crossfade",
        "strength": 0.5
      }
    },
    "Filter Blend": {
      "bars": 8,
      "sync": true,
      "volume": {
        "curve": "crossfade",
        "strength": 0.75
      },
      "bass": {
        "curve": "swap",
        "strength": 0.75,
        "swap": 0.5
      },
      "filter": {
        "curve": "crossfade",
        "strength": 1.0
      }
    },
    "Echo Out": {
      "bars": 4,
      "sync": false,
      "volume": {
        "curve": "crossfade",
        "strength": 0.5
      },
      "echo": {
        "curve": "fade_out",
        "strength": 0.75
      }
    },
    "Quick Cut": {
      "bars": 1,
      "sync": false,
      "volume": {
        "curve": "swap",
        "strength": 1.0,
        "swap": 1.0
      }
    },
    "Stem Swap": {
      "bars": 16,
      "sync": true,
      "volume": {
        "curve": "crossfade",
        "strength": 0.25
      },
      "stem_drums": {
        "curve": "swap",
        "strength": 0.75,
        "swap": 0.5
      },
      "stem_bass": {
        "curve": "swap",
        "strength": 1.0,
        "swap": 0.5
      },
      "stem_melody": {
        "curve": "crossfade",
        "strength": 0.5
      },
      "stem_vocals": {
        "curve": "crossfade",
        "strength": 0.75
      }
    }
  },
  "rules": [
    {
      "label": "Perfect Match",
      "within": "Long Blend",
      "above": "Smooth Blend",
      "above_tempo": "second_half"
    },
    {
      "label": "Perfect Drop",
      "within": "Smooth Blend",
      "above": "Filter Blend",
      "above_tempo": "second_half"
    },
    {
      "label": "Perfect Boost",
      "within": "Smooth Blend",
      "above": "Filter Blend",
      "above_tempo": "second_half"
    },
    {
      "colour": "yellow",
      "within": "Filter Blend",
      "above": "Echo Out"
    },
    {
      "colour": "blue",
      "within": "Echo Out",
      "above": "Echo Out"
    },
    {
      "colour": "red",
      "within": "Echo Out",
      "above": "Quick Cut"
    }
  ],
  "defaults": {
    "in_offset_bars": 0,
    "out_offset_bars": 0,
    "preview_lead_bars": 8,
    "tempo": "full",
    "echo_feedback": 0.55,
    "echo_wet": 0.7,
    "echo_tail_bars": 4,
    "limiter_ceiling_db": -1.0
  }
}
